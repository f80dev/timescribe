# Google OAuth (cf README §OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Minimax M3 — LLM d'estimation
# (obtenu sur https://platform.minimax.io/user-center/basic-information/interface-key)
MINIMAX_API_KEY=

# Override éventuel du baseURL (laisser vide pour utiliser la valeur par défaut)
MINIMAX_BASE_URL=https://api.minimax.io/v1